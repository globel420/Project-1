    {
      "id": "bit_math",
      "kind": "binary_math_intro",
      "duration_seconds": 13,
      "spoken": "bitRead shifts the number right, then uses bitwise AND with one. The shift moves the chosen bit to the rightmost position. AND keeps only that bit.",
      "visual": {
        "title": "The actual code inside bitRead",
        "expression": "(value >> bit) & 0x01",
        "shift_bit_index": 1,
        "mask_binary": "00001",
        "comparisons": [
          {
            "count": 2,
            "binary": "00010",
            "shifted_binary": "00001",
            "mask_result_binary": "00001",
            "result": 1,
            "pin": 11
          },
          {
            "count": 13,
            "binary": "01101",
            "shifted_binary": "00110",
            "mask_result_binary": "00000",
            "result": 0,
            "pin": 11
          }
        ],
        "note": "0x01 is 1. Bitwise AND with 00001 keeps only the rightmost bit."
      },
      "start_seconds": 46,
      "end_seconds": 59
    },
    {
